{
  "name": "meisters-baton",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build --logLevel warn && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "tsx server/index.ts",
    "start:laptop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-laptop.ps1",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "assets:icons": "node scripts/generate-icons.mjs",
    "mobile:preflight": "node scripts/mobile-preflight.mjs",
    "discord:archive": "node scripts/discord-archive.mjs",
    "discord:share": "node scripts/build-discord-share.mjs",
    "wiki:propeller": "node scripts/build-propeller-wiki.mjs",
    "wiki:context": "tsx scripts/export-process-video-context.ts",
    "format": "prettier --write src server tests scripts *.ts *.json *.html .github docs README.md AGENTS.md",
    "format:check": "prettier --check src server tests scripts *.ts *.json *.html .github docs README.md AGENTS.md",
    "test:offline": "tsx scripts/offline-qa.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.1",
    "@capacitor/share": "8.0.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@supabase/supabase-js": "2.57.4",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "idb": "8.0.3",
    "katex": "^0.18.7",
    "lucide-react": "1.41.0",
    "multer": "2.3.0",
    "openai": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "1.63.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
