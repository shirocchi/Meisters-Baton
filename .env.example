# Browser-safe Supabase project settings. Use the publishable key, never a secret/service key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Laptop gateway: ChatGPT login in Codex, no OpenAI API key required.
BATON_ALLOWED_TEAM_ID=
BATON_CODEX_MODEL=gpt-6-astra
# Verification builds do not automatically publish local records into team Wiki.
# Keep true while testing with fixtures. Rebuild after changing this flag.
VITE_BATON_VERIFICATION=true

# Server only. Never prefix this key with VITE_ or ship it in the mobile application.
OPENAI_API_KEY=
# Availability depends on the API account. The model name is deliberately configurable.
OPENAI_MODEL=gpt-6-astra
PORT=8787
HOST=127.0.0.1
DATA_DIR=./.data
NODE_ENV=development
# Exact, comma-separated app origins. Add the deployed HTTPS origin; never use *.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,capacitor://localhost,http://localhost,https://localhost
# Only set when deployed behind this exact number of trusted reverse proxy hops.
# TRUST_PROXY_HOPS=1
